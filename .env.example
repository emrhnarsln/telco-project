# =============================================================
# Telco Project - Environment Variables Template
# =============================================================
# Copy this file to .env and fill in your own values:
#   cp .env.example .env
#
# WARNING: Never commit the actual .env file to version control.
# =============================================================


# -------------------------------------------------------------
# Oracle SYS / SYSTEM password
# Used by the DBA superuser account inside the container.
# -------------------------------------------------------------
ORACLE_SYS_PASSWORD=TelcoAdmin2025


# -------------------------------------------------------------
# Application user credentials
# A dedicated schema user will be created automatically
# by the container on first startup.
# -------------------------------------------------------------
ORACLE_APP_USER=telco
ORACLE_APP_PASSWORD=Telco2025


# -------------------------------------------------------------
# Port mappings (host:container)
# Change the left-hand side if the default ports are occupied.
# -------------------------------------------------------------
ORACLE_PORT=1521
ORACLE_EM_PORT=5500
